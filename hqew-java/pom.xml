<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.andygrove.kquery</groupId>
    <artifactId>kquery-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>KQuery Java</name>
    <description>Java 27 learning port of How Query Engines Work</description>

    <properties>
        <maven.compiler.release>27</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.12.2</junit.version>
        <jspecify.version>1.0.0</jspecify.version>
        <jspecify-packageinfo-generator.version>1.2.0</jspecify-packageinfo-generator.version>
        <error-prone.version>2.49.0</error-prone.version>
        <nullaway.version>0.13.4</nullaway.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.z.openapi</groupId>
            <artifactId>zai-sdk</artifactId>
            <version>0.3.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.bcaillard.jspecify-utilities</groupId>
                <artifactId>jspecify-packageinfo-generator-maven-plugin</artifactId>
                <version>${jspecify-packageinfo-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-package-info</id>
                        <goals>
                            <goal>generate-package-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>generate-package-info-test</id>
                        <goals>
                            <goal>generate-package-info-test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <argLine>--enable-preview</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      NullAway/ErrorProne run as a javac Xplugin, which needs error_prone_core on
      javac's processor/plugin path. IntelliJ's JPS build cannot provide that, so
      this config lives in a profile: active by default for every plain `mvn` run,
      but IDEA's Maven importer can leave it unchecked (per-project workspace
      setting, survives re-imports) so .idea/compiler.xml stays clean.
      Requires the add-exports/add-opens flags in .mvn/jvm.config.
    -->
    <profiles>
        <profile>
            <id>nullaway</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <compilerArgs>
                                <arg>--enable-preview</arg>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR
                                    -XepOpt:NullAway:AnnotatedPackages=org.kogu,io.andygrove
                                    -XepOpt:NullAway:JSpecifyMode=true
                                </arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${error-prone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${nullaway.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
